<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Интернет обязателен -->
    <uses-permission android:name="android.permission.INTERNET"/>
    
    <!-- CALL_PHONE убран: приложение не звонит само, а открывает системный
         набор номера через tel:. Для этого разрешение не нужно, а Google
         Play разбирает его особенно придирчиво: оно даёт право совершать
         звонки без ведома пользователя. -->

    <!-- Разрешение для пуш-уведомлений (Android 13+) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>

    <!-- Разрешения для сохранения файлов в галерею.
         Ограничены по версии Android: начиная с Android 13 доступ к
         картинкам даёт READ_MEDIA_IMAGES, а с Android 10 запись в свою
         папку галереи разрешения не требует вовсе. Без ограничения Google
         спрашивает, зачем приложению полный доступ к хранилищу. -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32"/>
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28"/>
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES"/>

    <!-- SCHEDULE_EXACT_ALARM убран: точные будильники в коде не
         используются, фоновые задачи идут через workmanager с обычным
         расписанием. Разрешение относится к особым, его наличие требует
         обоснования в консоли. -->

    <!-- Позволяет приложению предотвращать переход устройства в спящий режим -->
    <uses-permission android:name="android.permission.WAKE_LOCK"/>

    <!-- Разрешения FOREGROUND_SERVICE, FOREGROUND_SERVICE_DATA_SYNC и
         REQUEST_IGNORE_BATTERY_OPTIMIZATIONS убраны вместе с сервисом,
         который держал соединение при закрытом приложении. Последнее из
         них Google Play отдельно называет допустимым лишь в узком списке
         случаев, к которым доска объявлений не относится. -->

    <!-- Разрешение для доступа к контактам.
         Используется на экране «Пригласить друзей», спрашивается у
         пользователя в момент открытия экрана. В анкете Data Safety
         объявляется как «Контакты». -->
    <uses-permission android:name="android.permission.READ_CONTACTS"/>

    <!-- Вычищаем разрешения, которые подмешивают за нас сторонние пакеты.
         Пакет локальных уведомлений объявляет их на все случаи жизни, а мы
         ни точных будильников, ни уведомлений во весь экран не используем.
         Все три относятся к особым: увидев их в сборке, Google Play
         потребует письменного обоснования, которого у нас нет. -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM"
        tools:node="remove"/>
    <uses-permission android:name="android.permission.USE_EXACT_ALARM"
        tools:node="remove"/>
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT"
        tools:node="remove"/>

    <!-- Разрешения для бейджей приложения (требуется для Nova, Apex, Samsung) -->
    <uses-permission android:name="android.permission.INSTALL_SHORTCUT" />
    <uses-permission android:name="com.android.launcher.permission.INSTALL_SHORTCUT" />
    <uses-permission android:name="com.android.launcher.permission.UNINSTALL_SHORTCUT" />
    <uses-permission android:name="com.android.launcher.permission.READ_SETTINGS" />
    <uses-permission android:name="com.android.launcher.permission.WRITE_SETTINGS" />
    
    <!-- Разрешения для специфичных лаунчеров -->
    <uses-permission android:name="com.teslacoilsw.notifier.permission.SEND_NOTIFICATION" /> <!-- Nova Launcher -->
    <uses-permission android:name="com.sec.android.provider.badge.permission.READ" /> <!-- Samsung -->
    <uses-permission android:name="com.sec.android.provider.badge.permission.WRITE" /> <!-- Samsung -->
    <uses-permission android:name="com.sonyericsson.home.permission.BROADCAST_BADGE" /> <!-- Apex Launcher -->

    <!-- usesCleartextTraffic=false: обмен только по https. Раньше стояло
         true, то есть приложению разрешалось ходить и по незашифрованному
         http. Ни один наш адрес этого не требует, а проверка перед
         публикацией отмечает такое как замечание по безопасности. -->
    <application
        android:label="LIDLE"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:usesCleartextTraffic="false">
        
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />

        <!-- Канал уведомлений по умолчанию для пушей Firebase.
             Страховка на случай, если пуш придёт до того, как приложение
             успело создать свои каналы: например, сразу после установки,
             когда пользователь ещё ни разу не открывал приложение. Без
             этой строки система отбросит уведомление молча, а сервер
             получит от Google ответ «принято». -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="general_channel" />

        <!-- Сервис для Workmanager (фоновые задачи) -->
        <service
            android:name="be.tramckrijte.workmanager.BackgroundWorker"
            android:permission="android.permission.BIND_JOB_SERVICE"
            android:exported="false" />

        <!-- Здесь был сервис flutter_foreground_task, который держал
             соединение с сервером при закрытом приложении. Убран: Google
             Play проверяет каждый фоновый сервис типа dataSync и не
             принимает обоснование «держим соединение ради уведомлений».
             Уведомления при закрытом приложении доставляет Firebase. -->
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <!-- Télефонные звонки -->
        <intent>
            <action android:name="android.intent.action.DIAL"/>
        </intent>
        <intent>
            <action android:name="android.intent.action.CALL"/>
        </intent>
        <!-- Открытие URL в браузере -->
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="http"/>
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="https"/>
        </intent>

        <package android:name="com.vkontakte.android" />
        <package android:name="com.vk.im" />
        <package android:name="ru.mail.mailapp" />
        <package android:name="ru.ok.android" />

    </queries>
</manifest>
